// Если этот файл ещё не подключён, обработать его содержимое. Это защита от повторного объявления одних и тех же имён.
#ifndef ARS3D_SHADER_PLATFORM
// Поставить отметку: настройки платформы уже подключены.
#define ARS3D_SHADER_PLATFORM

// Выбрать ветку для OpenGL. MonoGame DesktopGL задаёт это определение при сборке эффекта.
#if OPENGL
    // В этой ветке заменить имя SV_POSITION на POSITION: так запись позиции подходит используемому профилю компиляции.
    #define SV_POSITION POSITION
    // Сокращённое имя версии vertex shader для OpenGL-ветки.
    #define VS_SHADERMODEL vs_3_0
    // Сокращённое имя версии pixel shader для OpenGL-ветки.
    #define PS_SHADERMODEL ps_3_0
// Альтернативная ветка для сборки без определения OPENGL.
#else
    // Версия vertex shader для альтернативной ветки.
    #define VS_SHADERMODEL vs_4_0_level_9_1
    // Версия pixel shader для альтернативной ветки.
    #define PS_SHADERMODEL ps_4_0_level_9_1
// Конец условного блока препроцессора: это обработка исходника при сборке, а не условие во время кадра.
#endif

// Конец условного блока препроцессора: это обработка исходника при сборке, а не условие во время кадра.
#endif