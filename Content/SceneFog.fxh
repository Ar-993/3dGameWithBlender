// Защита общих параметров тумана от повторного объявления.
#ifndef ARS3D_SCENE_FOG
// Отметить, что параметры тумана уже подключены.
#define ARS3D_SCENE_FOG

// C# передаёт 0 для выключенного тумана или 1 для включённого.
float FogEnabled;
// RGB цвета тумана. В этой функции не используется, но нужен вызывающему шейдеру для смешивания.
float3 FogColor;
// Расстояние от камеры, до которого туман ещё отсутствует.
float FogStart;
// Расстояние от камеры, на котором туман полностью закрывает поверхность.
float FogEnd;

// Получить расстояние и вернуть долю тумана от 0 до 1.
float CalculateFogAmount(float radialDistance)
{
    // Сдвинуть начало к FogStart, разделить на длину перехода и ограничить 0..1; max защищает знаменатель от нуля.
    return saturate((radialDistance - FogStart) / max(FogEnd - FogStart, 0.001))
        // При FogEnabled = 0 обнулить туман, при 1 сохранить вычисленную долю.
        * FogEnabled;
}

// Конец условного блока препроцессора: это обработка исходника при сборке, а не условие во время кадра.
#endif
